{% extends 'base.html.twig' %}

{% block title %}Homepage{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/css/accueil.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}

<div class="container-lg d-flex row">
    <div class="col">
        <div class="home-section-text">
            <h1 class="h1-heading title-home">Tout Pour La Culture</h1>
            <p class="p1-paragraph text-shadow text-home">
                Fun, Musique et Interview. Découvrez les nouveaux talents du rap via notre média...
            </p>
        </div>
        <div {{react_component('Buttons/ClassicButton', {
            width : "13rem",
            height : "4.5rem",
            padding : "1.375rem 3.75rem",
            margin : "0rem",
            text : "S'inscrire",
            link : "/inscription",
            color : "white",
            text_color : "black"
        })}}></div>
    </div>
    <div id="main-image col">
        <div {{react_component('Images/Image', {
            src : "/img/plain/man_in_city_no_background.png", 
            alt : "main_in_city_no_background",
            width : "auto",
            height : "87.5rem",
            margin : 0
        })}}></div>
        <div id="blur1"></div>
        <div class="blur-width" id="band-blur1"></div>
    </div>
</div>

<div class="section-separator"></div>

<div class="container-lg">
    <div id="news-image">
        <div id="news-image-frame">
            <div {{react_component('Images/Image', {
                src : "/img/plain/man_singing.jpg", 
                alt : "artist_no_background",
                width : "35rem",
                height : "auto",
                margin : 0,
                border : "1.5rem"
            })}}></div>
            <h3 class="h3-heading">Titre</h3>
            <p class="ui-label-regular">il y a 12 heures</p>
            <div class="image-shadow" id="shadow-news-image" 
                style="
                width: 35rem; 
                height: 5.7rem;
                border-radius: 0 0 1.5rem 1.5rem";
            >
            </div>
            <div {{react_component('Images/Image', {
                src : "/img/plain/man_singing.jpg", 
                alt : "artist_no_background",
                width : "100%",
                margin : "-20rem 0 0 0"
            })}}
            style="
                overflow: hidden; 
                width: 35rem; 
                height: 5rem; 
                border-radius: 1.5rem;
                margin-top: 6rem;
                filter: blur(2rem)"
            ></div>
        </div>
    </div>

    <div class="container-lg">
        <div class="home-section-text">
            <h1 class="h1-heading title-home">Les Dernières News</h1>
            <p class="p1-paragraph text-shadow text-home">
                Tenez-vous au courant de l’actu musical et des dernières sorties en nous suivant sur les réseaux.
            </p>
        </div>
    </div>
</div>

<div class="home-section-line">
    <div class="home-title-section">
        <div class="home-section-text">
            <h1 class="h1-heading title-home-center">Les Dernières Vidéos en Légende</h1>
            <p class="p1-paragraph text-shadow text-home">
                Le Flow, la 111ème ou encore nos clips musicaux. Suivez en temps réel nos contenus vidéos pour découvrir de nombreux artistes et de nouvelles musiques.
            </p>
        </div>
    </div>
</div>

<div class="container py-4 px-3 mx-auto">
    <h1>Hello, Bootstrap and Webpack!</h1>
    <button class="btn btn-primary">Primary button</button>
</div>


{% endblock %}
