{% extends 'base.html.twig' %}

{% block title %}Inflow - Playlists{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/styles/spotify.css') }}">
{% endblock %}

{% block body %}



    <link rel="alternate" type="application/json+oembed" href="https://open.spotify.com/oembed?url=https%3A%2F%2Fopen.spotify.com%2Fshow%2F5eXZwvvxt3K2dxha3BSaAe" />
    {# {{ dump(playlists) }} #}
    <div {{
